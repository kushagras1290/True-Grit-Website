{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "truegrit-lang-dev",
  "compatibility_date": "2026-07-11",
  "workers_dev": true,
  "routes": [{ "pattern": "langtest.truegritin.com", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
  },
  "env": {
    "staging": {
      "name": "truegrit-lang-staging",
      "workers_dev": true,
      "routes": [{ "pattern": "langstag.truegritin.com", "custom_domain": true }],
      "assets": {
        "directory": "./dist",
        "not_found_handling": "single-page-application",
      },
    },
    "production": {
      "name": "truegrit-lang-prod",
      "workers_dev": true,
      "routes": [{ "pattern": "lang.truegritin.com", "custom_domain": true }],
      "assets": {
        "directory": "./dist",
        "not_found_handling": "single-page-application",
      },
    },
  },
}
