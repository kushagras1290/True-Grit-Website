{
  // Cloudflare Workers static-assets deployment for the admin SPA.
  // Build with `vite build` (outputs ./dist), then `wrangler deploy`. This is an
  // assets-only Worker (no server code): Cloudflare serves the built files and,
  // via single-page-application handling, returns index.html for unknown paths
  // so client-side routing works. Set VITE_API_URL at build time to connect the
  // admin to the API; unset => the UI runs in demo mode.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "truegrit-admin-dev",
  "compatibility_date": "2026-07-11",
  // The top-level Worker is deployed from `testing`; reviewers use a stable
  // domain while the Worker retains its existing dev resource bindings.
  "workers_dev": true,
  "routes": [{ "pattern": "adtest.truegritin.com", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
  },
  "env": {
    // Deployed by .github/workflows/deploy-staging.yml on every push to the
    // `staging` branch. VITE_API_URL is set at build time in that workflow
    // (this is an assets-only Worker — no server-side vars to set here).
    "staging": {
      "name": "truegrit-admin-staging",
      "workers_dev": true,
      "routes": [{ "pattern": "adstag.truegritin.com", "custom_domain": true }],
      "assets": {
        "directory": "./dist",
        "not_found_handling": "single-page-application",
      },
    },
    // Deployed manually via .github/workflows/deploy-web-environment.yml
    // (typed-confirmation gate, same pattern as deploy-api-environment.yml) --
    // never automatically on push. VITE_API_URL is set at build time in that
    // workflow, pointing at the isolated truegrit-api-prod Worker.
    "production": {
      "name": "truegrit-admin-prod",
      "workers_dev": true,
      "routes": [{ "pattern": "admin.truegritin.com", "custom_domain": true }],
      "assets": {
        "directory": "./dist",
        "not_found_handling": "single-page-application",
      },
    },
  },
}
