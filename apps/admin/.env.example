# True Grit admin console — copy to .env for local development.

# Browser calls the admin API here (with cookies). Unset => demo/fixture mode.
VITE_API_URL=http://localhost:8787

# Client-side Sentry error reporting DSN (see src/lib/sentry.ts).
# Unset => Sentry.init is never called; the app behaves identically to today.
VITE_SENTRY_DSN=
