{
  // Cloudflare Workers deployment target for the SSR storefront.
  // Build with `react-router build` (the @cloudflare/vite-plugin bundles the
  // server build + client assets and writes a deploy-redirect); then
  // `wrangler deploy` ships that built output. See vite.config.ts and
  // infrastructure/cloudflare/README.md.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "truegrit-storefront-dev",
  "main": "./workers/app.ts",
  "compatibility_date": "2026-07-11",
  // nodejs_compat also populates `process.env` from the vars/secrets below, which
  // is how the SSR loaders read PUBLIC_API_URL (app/lib/catalogue.server.ts).
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "upload_source_maps": true,
  "services": [{ "binding": "API_WORKER", "service": "truegrit-api-dev" }],
  "vars": {
    // Runtime public API origin. The browser receives this value from SSR so
    // production builds cannot accidentally keep a local VITE_API_URL baked in.
    "PUBLIC_API_URL": "https://truegrit-api-dev.kushagras1234890.workers.dev",
    // Public Facebook app id for the storefront account menu. Whether the
    // button is *shown* is an admin-console switch (Site Control -> Storefront
    // switches), not an env flag — see migration 0040.
    "PUBLIC_FACEBOOK_APP_ID": "",
  },
  "env": {
    // Deployed by .github/workflows/deploy-staging.yml on every push to the
    // `staging` branch — the middle rung between `testing` (CI only) and
    // `main` (live, deploy.yml). Talks to the isolated truegrit-api-staging
    // Worker/D1/R2/Queues (apps/api/wrangler.jsonc's own env.staging).
    "staging": {
      "name": "truegrit-storefront-staging",
      "workers_dev": true,
      "observability": { "enabled": true },
      "upload_source_maps": true,
      "services": [{ "binding": "API_WORKER", "service": "truegrit-api-staging" }],
      "vars": {
        "PUBLIC_API_URL": "https://truegrit-api-staging.kushagras1234890.workers.dev",
        "PUBLIC_FACEBOOK_APP_ID": "",
      },
    },
    // Deployed manually via .github/workflows/deploy-web-environment.yml
    // (typed-confirmation gate, same pattern as deploy-api-environment.yml) --
    // never automatically on push. Talks to the isolated truegrit-api-prod
    // Worker/D1/R2/Queues (apps/api/wrangler.jsonc's own env.production).
    // Both routes point at this one Worker; workers/app.ts 301-redirects
    // www -> the canonical apex domain before rendering anything.
    "production": {
      "name": "truegrit-storefront-prod",
      "workers_dev": true,
      "observability": { "enabled": true },
      "upload_source_maps": true,
      "routes": [
        { "pattern": "truegritin.com", "custom_domain": true },
        { "pattern": "www.truegritin.com", "custom_domain": true },
      ],
      "services": [{ "binding": "API_WORKER", "service": "truegrit-api-prod" }],
      "vars": {
        "PUBLIC_API_URL": "https://api.truegritin.com",
        "PUBLIC_FACEBOOK_APP_ID": "",
        "CANONICAL_HOST": "truegritin.com",
      },
    },
  },
}
