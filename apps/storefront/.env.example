# True Grit storefront — copy to .env for local development.

# SSR route loaders call the API here. Unset => demo/fixture mode (no API needed).
PUBLIC_API_URL=http://localhost:8787

# Browser calls the customer-auth API here (with cookies). Unset => demo mode
# (customer sessions are faked in localStorage so the UI stays reviewable).
VITE_API_URL=http://localhost:8787

# Public Google OAuth client id for "Sign in with Google".
# Unset => the Google button renders a "not configured" hint.
VITE_GOOGLE_CLIENT_ID=
