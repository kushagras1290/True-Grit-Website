# True Grit storefront — copy to .env for local development.

# SSR route loaders call the API here. Unset => demo/fixture mode (no API needed).
PUBLIC_API_URL=http://localhost:8787

# Browser calls the customer-auth API here (with cookies). Unset => demo mode
# (customer sessions are faked in localStorage so the UI stays reviewable).
VITE_API_URL=http://localhost:8787

# Public Google OAuth client id for "Sign in with Google".
# Unset => the Google button renders a "not configured" hint.
VITE_GOOGLE_CLIENT_ID=

# Public Facebook app id for "Continue with Facebook".
# Unset => the Facebook button renders a "not configured" hint.
VITE_FACEBOOK_APP_ID=
# Optional runtime equivalent used by deployed Workers SSR.
PUBLIC_FACEBOOK_APP_ID=
# Keep false until Facebook Login is ready for customers.
VITE_FACEBOOK_LOGIN_VISIBLE=false
PUBLIC_FACEBOOK_LOGIN_VISIBLE=false

# Client-side Sentry error reporting DSN (see app/lib/sentry.client.ts).
# Unset => Sentry.init is never called; the app behaves identically to today.
VITE_SENTRY_DSN=
# Optional runtime equivalent used by deployed Workers SSR.
PUBLIC_SENTRY_DSN=
