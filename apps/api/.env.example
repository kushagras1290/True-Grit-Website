# True Grit API — copy to .env for local development. Never commit real secrets.

# development | test | staging | production
APP_ENV=development

# CORS + cookie origins
PUBLIC_STOREFRONT_URL=http://localhost:5173
PUBLIC_ADMIN_URL=http://localhost:5174

# --- Sessions & cookies ---
SESSION_COOKIE_NAME=tg_session
SESSION_LIFETIME_HOURS=72
# lax  => storefront/admin share a registrable domain with the API (subdomains are same-site)
# none => they are on different domains; the cookie is then forced Secure automatically
SESSION_COOKIE_SAMESITE=lax

# --- Admin console credential (change outside local dev) ---
ADMIN_LOGIN_EMAIL=admin@truegrit.test
ADMIN_LOGIN_PASSWORD=admin123

# --- Customer / staff passwords ---
# OWASP baseline is 600000 PBKDF2-HMAC-SHA256 iterations.
PBKDF2_ITERATIONS=600000
PASSWORD_MIN_LENGTH=10

# --- Google Sign-In ---
# Public OAuth client id (identical to the storefront's). Blank disables Google sign-in.
GOOGLE_CLIENT_ID=

# --- Rate limiting ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=900
RATE_LIMIT_LOGIN_PER_ACCOUNT=5
RATE_LIMIT_LOGIN_PER_IP=20
RATE_LIMIT_REGISTER_PER_IP=10
RATE_LIMIT_REGISTER_WINDOW_SECONDS=3600
RATE_LIMIT_GOOGLE_PER_IP=30
# Global per-IP ceiling applied to every route by middleware.
RATE_LIMIT_GLOBAL_PER_IP=300
RATE_LIMIT_GLOBAL_WINDOW_SECONDS=60

# --- Transactional email (order notifications, password resets) ---
# Leave SMTP_HOST blank to use the console sender (logs emails; safe for dev).
# On Cloudflare Workers, use an HTTP email API instead of raw SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_TIMEOUT_SECONDS=10
EMAIL_FROM=True Grit <no-reply@truegrit.test>
CONTACT_RECIPIENT_EMAIL=admin@truegrit.test
PASSWORD_RESET_LIFETIME_MINUTES=30

# --- Payments ---
# Cash-on-delivery is always on. Each online gateway activates only when its keys
# are set. Use TEST-MODE keys until go-live. For the deployed Workers, set these
# as secrets: `wrangler secret put RAZORPAY_KEY_SECRET` (etc.) — do NOT commit.
PAYMENT_CURRENCY=INR
PAYMENT_COD_ENABLED=true
# Razorpay (UPI + cards + netbanking + wallets — primary for India)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Stripe (cards, global)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# PayPal (global) — environment: sandbox | live
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_ENVIRONMENT=sandbox
