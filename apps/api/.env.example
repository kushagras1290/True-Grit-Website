# True Grit API — copy to .env for local development. Never commit real secrets.

# development | test | staging | production
APP_ENV=development

# CORS + cookie origins
PUBLIC_STOREFRONT_URL=http://localhost:5173
PUBLIC_ADMIN_URL=http://localhost:5174

# --- Sessions & cookies ---
SESSION_COOKIE_NAME=tg_session
SESSION_LIFETIME_HOURS=72
# lax  => storefront/admin share a registrable domain with the API (subdomains are same-site)
# none => they are on different domains; the cookie is then forced Secure automatically
SESSION_COOKIE_SAMESITE=lax

# --- Admin console owner credential (BOOTSTRAP ONLY) ---
# These open the owner account only until it has a password of its own. The first
# sign-in adopts them: ADMIN_LOGIN_EMAIL becomes the owner account's real address
# (so password-reset mail reaches a live inbox) and ADMIN_LOGIN_PASSWORD becomes
# its stored hash. After that, editing these changes nothing — rotate the
# password in the console (Your Account > Change password), which is what makes a
# change actually revoke the old password instead of leaving .env as a second way
# in. To hand the account back to .env, delete its user_credentials row.
#
# The password below is the shipped default and is REFUSED when APP_ENV=production
# so an unedited .env can never be a working owner login on a live store.
ADMIN_LOGIN_EMAIL=admin@truegrit.test
ADMIN_LOGIN_PASSWORD=admin123

# --- Customer / staff passwords ---
# Python Workers need a lower PBKDF2 budget to avoid CPU-limit 503s before CORS
# headers can be written. Keep new hashes and accepted stored hashes aligned.
PBKDF2_ITERATIONS=50000
PBKDF2_VERIFY_MAX_ITERATIONS=50000
PASSWORD_MIN_LENGTH=10

# --- Google Sign-In ---
# Public OAuth client id (identical to the storefront's). Blank disables Google sign-in.
GOOGLE_CLIENT_ID=

# --- Facebook Sign-In ---
# Public app id + server-side app secret. Blank disables Facebook sign-in.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# --- Rate limiting ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=900
RATE_LIMIT_LOGIN_PER_ACCOUNT=5
RATE_LIMIT_LOGIN_PER_IP=20
RATE_LIMIT_REGISTER_PER_IP=10
RATE_LIMIT_REGISTER_WINDOW_SECONDS=3600
RATE_LIMIT_GOOGLE_PER_IP=30
RATE_LIMIT_FACEBOOK_PER_IP=30
# Global per-IP ceiling applied to every route by middleware.
RATE_LIMIT_GLOBAL_PER_IP=300
RATE_LIMIT_GLOBAL_WINDOW_SECONDS=60

# --- Transactional email (order notifications, password resets) ---
# Leave RESEND_API_KEY and SMTP_HOST blank to use the console sender (safe for dev).
# On Cloudflare Workers, use RESEND_API_KEY instead of raw SMTP.
RESEND_API_KEY=
RESEND_API_URL=https://api.resend.com/emails
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_TIMEOUT_SECONDS=10
EMAIL_FROM=True Grit <no-reply@truegrit.test>
CONTACT_RECIPIENT_EMAIL=admin@truegrit.test
PASSWORD_RESET_LIFETIME_MINUTES=30

# --- Mobile verification (SMS one-time passcodes) ---
# Leave FAST2SMS_API_KEY blank for the console sender, which logs the passcode
# instead of texting it — no account, no spend, and the whole flow still works
# locally. The API REFUSES that fallback when APP_ENV is staging/production
# (logging live OTPs would be an account-takeover vector), so a real key is
# required before deploying. Set it as a secret, never in this file:
#   wrangler secret put FAST2SMS_API_KEY
#
# Why Fast2SMS: its `route=otp` reaches Indian mobiles on the provider's own
# pre-approved DLT header, so there is no ₹5,900 TRAI DLT registration to
# complete first. New accounts get ₹50 free credit (~240 passcodes); after that
# it is roughly ₹0.21-0.25 per SMS. Swapping providers means one class in
# `services/sms.py` — we generate and verify the codes ourselves.
FAST2SMS_API_KEY=
OTP_LENGTH=6
OTP_LIFETIME_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_MAX_RESENDS=3
OTP_RESEND_COOLDOWN_SECONDS=30
# Issuance ceilings: per-phone protects the number's owner and the SMS bill,
# per-IP stops one host enumerating many numbers.
RATE_LIMIT_OTP_PER_PHONE=5
RATE_LIMIT_OTP_PER_IP=20
RATE_LIMIT_OTP_WINDOW_SECONDS=3600
# New accounts must verify a mobile. Existing accounts are prompted but may
# skip, and are asked again at checkout where a live number actually matters.
PHONE_REQUIRED_AT_REGISTRATION=true
PHONE_REQUIRED_AT_CHECKOUT=true

# --- Payments ---
# Cash-on-delivery is always on. Use TEST-MODE keys until go-live. For the
# deployed Workers, set secrets with `wrangler secret put RAZORPAY_KEY_SECRET`
# (etc.) — do NOT commit real keys.
#
# Keys alone do NOT put a gateway in front of customers. Razorpay is the only one
# with a finished checkout; PayPal ships behind PAYMENT_PAYPAL_VISIBLE and Stripe
# behind PAYMENT_STRIPE_VISIBLE (both default false), so pasting a key here
# cannot accidentally offer a method that would strand a customer with an unpaid
# order. Flip the flag on only after testing the flow end to end.
PAYMENT_CURRENCY=INR
PAYMENT_COD_ENABLED=true
# Razorpay (UPI + cards + netbanking + wallets — primary for India)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Stripe (cards, global) — configuration only; no checkout implementation yet.
PAYMENT_STRIPE_VISIBLE=false
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# PayPal — INTERNATIONAL ONLY.
# PayPal closed its domestic India business on 1 April 2021: an Indian merchant
# cannot take INR from an Indian customer. What still works is an overseas buyer
# paying an Indian merchant — the NRI case (pay from abroad, deliver to family in
# India). Domestic customers use Razorpay or COD.
PAYMENT_PAYPAL_VISIBLE=false
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_WEBHOOK_ID=
# What the overseas buyer is charged in. Never INR — PayPal will not settle a
# domestic INR payment. Supported: USD, GBP, EUR, AUD, CAD, SGD.
PAYPAL_CURRENCY=USD
# Rupees per one unit of PAYPAL_CURRENCY (e.g. 88.5 INR per USD). Orders are
# priced in INR, so a cross-border charge must be converted and there is no way
# to do that without a rate. Deliberately fixed rather than a live FX lookup: an
# FX API is another key, another dependency and another outage on the checkout
# path, and a silently moving rate makes order totals unreproducible. Set it
# slightly in the store's favour to absorb drift and review it periodically.
# Zero disables PayPal — the API refuses to offer a gateway it cannot price.
PAYPAL_INR_PER_UNIT=0
