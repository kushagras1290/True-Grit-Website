{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "truegrit-api-dev",
  "main": "src/worker.py",
  "compatibility_date": "2026-07-11",
  "compatibility_flags": ["python_workers"],
  // DO NOT add a `limits` block here. This account is on the Workers Free
  // plan, which rejects the deploy outright:
  //   "CPU limits are not supported for the Free plan" [code: 100328]
  // That is why commit 68eaf84 removed `limits.cpu_ms` — not because native
  // crypto made it unnecessary. It has now been added and reverted twice.
  //
  // The Free plan caps CPU at 10 ms per request, and this whole FastAPI app
  // runs in Pyodide, where marshalling payloads between JS and Python costs
  // far more CPU than native JS. Requests that blow the cap are killed with
  // outcome `exceededCpu`, and Cloudflare's own error response carries no
  // Access-Control-Allow-Origin header — which the browser reports as a CORS
  // failure, masking the real cause. Raising the ceiling needs the Workers
  // Paid plan; until then the only lever is doing less work per request (see
  // the R2 direct-serve path for /media/* in src/worker.py).
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "truegrit-dev",
      "database_id": "ca1cec13-5ec4-4e59-85ef-1115b365bb89",
      "migrations_dir": "../../database/migrations"
    }
  ],
  // Staff messaging (migration 0073, truegrit_api/realtime/chat_room.py). One
  // ChatRoomDO per conversation, addressed by env.CHAT_ROOMS.get_by_name(id).
  // SQLite-backed classes are available on the Workers Free plan; this DO
  // does not use its own storage.sql at all (messages live in D1, see
  // chat_room.py's module docstring) -- new_sqlite_classes is still the
  // required migration shape even for a DO that only uses ctx.storage.put/get.
  "durable_objects": {
    "bindings": [{ "name": "CHAT_ROOMS", "class_name": "ChatRoomDO" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ChatRoomDO"] }],
  "r2_buckets": [
    { "binding": "MEDIA_BUCKET", "bucket_name": "truegrit-media-dev" },
    { "binding": "EXPORTS_BUCKET", "bucket_name": "truegrit-exports-dev" }
  ],
  "kv_namespaces": [{ "binding": "CACHE", "id": "c90a4639e7a748c89a9f81db6b19e75f" }],
  // Auto-translate for admin-authored page content (migration 0067,
  // platform/translation.py) -- runs @cf/meta/m2m100-1.2b on the Workers AI
  // free daily neuron allowance. Only invoked from an admin's own
  // "Auto-translate" action (never per-visitor), so the free tier easily
  // covers it. No separate API key or account: bindings authenticate via
  // the Worker's own execution context.
  "ai": {
    "binding": "AI"
  },
  "queues": {
    "producers": [{ "binding": "JOBS_QUEUE", "queue": "truegrit-jobs-dev" }]
  },
  "triggers": {
    // Daily at 03:00 UTC (08:30 IST) -- before typical same-day dispatch
    // hours. Drives Subscribe & Save renewals (Default.scheduled in
    // worker.py); a no-op cost of one settings read on stores that have
    // never turned the feature on. See services/subscriptions.py.
    "crons": ["0 3 * * *"]
  },
  "vars": {
    "APP_ENV": "development",
    // Deployed origins so the API's CORS allow-list accepts the live storefront
    // and admin (read by config.py via the worker.py env bridge). Update these
    // when the Worker names/subdomain change.
    "PUBLIC_STOREFRONT_URL": "https://truegrit-storefront-dev.kushagras1234890.workers.dev",
    "PUBLIC_ADMIN_URL": "https://truegrit-admin-dev.kushagras1234890.workers.dev",
    // Public Google OAuth client id (not a secret) — enables server-side
    // verification of "Sign in with Google" ID tokens.
    "GOOGLE_CLIENT_ID": "550781007803-reqflk6ao179tttf6a3n150ft96dgekl.apps.googleusercontent.com",
    // Public Facebook app id. Set FACEBOOK_APP_SECRET with
    // `wrangler secret put FACEBOOK_APP_SECRET` to enable Facebook sign-in.
    "FACEBOOK_APP_ID": "",
    // Storefront/admin and API are on different workers.dev subdomains, so the
    // session cookie must be cross-site. "none" makes config.py also mark it
    // Secure; CSRF tokens (x-csrf-token) remain the CSRF defence. Without this
    // the browser drops the session cookie and logins never persist.
    "SESSION_COOKIE_SAMESITE": "none",
    // Python Workers have a tight CPU window; 600k PBKDF2 iterations can exceed
    // it and Cloudflare returns 503 before CORS headers are written. Keep dev
    // credentials at the Worker-safe factor already used by farm-owner resets.
    "PBKDF2_ITERATIONS": "50000",
    "PBKDF2_VERIFY_MAX_ITERATIONS": "50000",

    // --- Mobile verification (SMS passcodes) ---
    // OFF until the SMS provider is wired. Nothing here can deliver a passcode
    // yet: FAST2SMS_API_KEY is unset, so the console sender stands in and prints
    // the code to the Worker log where a customer will never see it. Requiring a
    // verified mobile before that key exists would lock every customer out of
    // registration and checkout.
    //
    // GO-LIVE, in this order:
    //   1. `wrangler secret put FAST2SMS_API_KEY`   (never a var — it is a secret)
    //   2. flip both flags below to "true"
    //   3. redeploy and place one test order
    "PHONE_REQUIRED_AT_REGISTRATION": "false",
    "PHONE_REQUIRED_AT_CHECKOUT": "false",

    // --- Payments ---
    // Razorpay is the only gateway with a finished checkout. PayPal and Stripe
    // stay hidden so that adding a key cannot advertise a method that would
    // strand a customer with an order they are unable to pay.
    "PAYMENT_STRIPE_VISIBLE": "false",
    // PayPal is INTERNATIONAL ONLY — PayPal closed domestic India payments in
    // April 2021, so an Indian customer cannot pay an Indian merchant in INR.
    // Before flipping this to "true": set PAYPAL_CLIENT_ID here, put
    // PAYPAL_SECRET in as a secret, and set a real PAYPAL_INR_PER_UNIT — that
    // rate is what an overseas buyer is actually charged. "0" disables PayPal.
    "PAYMENT_PAYPAL_VISIBLE": "false",
    "PAYPAL_ENVIRONMENT": "sandbox",
    "PAYPAL_CLIENT_ID": "",
    "PAYPAL_CURRENCY": "USD",
    "PAYPAL_INR_PER_UNIT": "0"
  }
  // NOTE: every value in `vars` must be a JSON *string*. worker.py's env bridge
  // copies only strings into os.environ, so a bare `false` or `0` here would be
  // silently dropped and the setting would quietly fall back to its default.
}
